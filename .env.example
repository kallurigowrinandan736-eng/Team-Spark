# AquaQ Environment Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optimization & ML Settings
DEFAULT_RANDOM_SEED=42
QUANTUM_SIMULATION_MAX_ITERATIONS=1000
QUANTUM_SIMULATION_RESTARTS=4
CLASSICAL_SOLVER_TIMEOUT_SEC=10
DEMO_DATA_DIR=../data

# IBM Quantum Runtime Configuration (Optional - leave blank to run in local Qiskit simulation mode)
# NEVER commit real API keys to version control.
IBM_QUANTUM_CHANNEL=ibm_cloud
IBM_QUANTUM_INSTANCE_CRN=crn:v1:bluemix:public:quantum-computing:us-east:a/your_account_id:your_instance_id::
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here

